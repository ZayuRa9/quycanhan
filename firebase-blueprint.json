{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User workspace profile, categories, preferences, and Google Drive/Sheets linkage.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 256 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "driveRootFolderId": { "type": "string", "maxLength": 128 },
        "spreadsheetId": { "type": "string", "maxLength": 128 },
        "expenseCategories": { "type": "array", "description": "User-customized expense category list" },
        "incomeCategories": { "type": "array", "description": "User-customized income category list" },
        "reminderLeadDays": { "type": "integer" },
        "defaultPageSize": { "type": "integer" },
        "autoPreRestoreBackup": { "type": "boolean" },
        "lastDriveBackupAt": { "type": "string", "maxLength": 40 },
        "lastDriveBackupFileId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "FinancialAccount": {
      "title": "FinancialAccount",
      "description": "Cash fund, bank account, e-wallet, or savings account balance source.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["cash", "bank", "ewallet", "savings"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "bankName": { "type": "string", "maxLength": 120 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "initialBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "actualVerifiedBalance": { "type": "number" },
        "lastReconciledAt": { "type": "string", "maxLength": 40 },
        "reconciliationAttachments": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "name", "initialBalance", "currentBalance", "createdAt", "updatedAt"]
    },
    "CodeCounter": {
      "title": "CodeCounter",
      "description": "Monotonic transaction sequence counter per type and YYYY.MM.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "prefix": { "type": "string", "enum": ["KT", "KC", "CK"] },
        "yearMonth": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}$", "maxLength": 10 },
        "lastSeq": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "prefix", "yearMonth", "lastSeq", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Personal income, expense, or internal transfer ledger record with Drive proof metadata and audit history.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "code": { "type": "string", "pattern": "^(KT|KC|CK)-\\d{4}\\.\\d{2}-\\d{2,}$", "maxLength": 32 },
        "kind": { "type": "string", "enum": ["income", "expense", "transfer"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "actualAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "method": { "type": "string", "minLength": 1, "maxLength": 80 },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "accountName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "toAccountId": { "type": "string", "maxLength": 128 },
        "toAccountName": { "type": "string", "maxLength": 150 },
        "counterparty": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 2000 },
        "workDuration": { "type": "string", "maxLength": 120 },
        "purposeTag": { "type": "string", "maxLength": 120 },
        "startDate": { "type": "string", "maxLength": 20 },
        "expectedDate": { "type": "string", "maxLength": 20 },
        "actualDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "minLength": 1, "maxLength": 40 },
        "isArchived": { "type": "boolean" },
        "attachments": { "type": "array" },
        "driveMetadataFileId": { "type": "string", "maxLength": 128 },
        "calendarEventId": { "type": "string", "maxLength": 128 },
        "taskItemId": { "type": "string", "maxLength": 128 },
        "auditHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "code", "kind", "name", "amount", "category", "method", "accountId", "accountName", "expectedDate", "status", "isArchived", "attachments", "auditHistory", "createdAt", "updatedAt"]
    },
    "BudgetLimit": {
      "title": "BudgetLimit",
      "description": "Spending budget threshold configured by category, month, purpose, or work.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "scopeType": { "type": "string", "enum": ["category", "month", "purpose", "work"] },
        "scopeValue": { "type": "string", "minLength": 1, "maxLength": 150 },
        "yearMonth": { "type": "string", "minLength": 1, "maxLength": 10 },
        "limitAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "scopeType", "scopeValue", "yearMonth", "limitAmount", "createdAt", "updatedAt"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Personal savings goal with target amount, current accumulation, and optional linked account.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string", "maxLength": 20 },
        "linkedAccountId": { "type": "string", "maxLength": 128 },
        "linkedAccountName": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "completed", "paused"] },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "targetAmount", "currentAmount", "status", "createdAt", "updatedAt"]
    },
    "SavingsContribution": {
      "title": "SavingsContribution",
      "description": "Savings goal deposit or withdrawal contribution record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "goalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "goalName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "type": { "type": "string", "enum": ["deposit", "withdraw"] },
        "amount": { "type": "number" },
        "accountId": { "type": "string", "maxLength": 128 },
        "accountName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "minLength": 1, "maxLength": 20 },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "goalId", "goalName", "type", "amount", "date", "createdAt"]
    },
    "BackupRecord": {
      "title": "BackupRecord",
      "description": "Backup, pre-restore snapshot, restore, and Google Drive sync history entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["manual_export", "pre_restore_snapshot", "restore", "drive_backup", "excel_import"] },
        "recordCount": { "type": "integer" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "driveFileId": { "type": "string", "maxLength": 128 },
        "driveWebViewLink": { "type": "string", "maxLength": 500 },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "recordCount", "fileName", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable action audit trail for financial operations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entityType": { "type": "string", "enum": ["transaction", "account", "budget", "backup", "savings", "settings"] },
        "entityCode": { "type": "string", "minLength": 1, "maxLength": 120 },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 1000 },
        "actorEmail": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "entityType", "entityCode", "action", "details", "actorEmail", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, categories, settings, and Drive/Sheets config"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/FinancialAccount" },
      "description": "User financial accounts (cash, bank, e-wallet, savings)"
    },
    "/users/{userId}/codeCounters/{counterId}": {
      "schema": { "$ref": "#/entities/CodeCounter" },
      "description": "Monotonic transaction code sequence counters"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User income, expense, and internal transfer transactions"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/BudgetLimit" },
      "description": "User spending budget limits"
    },
    "/users/{userId}/savingsGoals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "User savings goals"
    },
    "/users/{userId}/savingsContributions/{contributionId}": {
      "schema": { "$ref": "#/entities/SavingsContribution" },
      "description": "User savings goal deposit and withdrawal history"
    },
    "/users/{userId}/backupHistory/{backupId}": {
      "schema": { "$ref": "#/entities/BackupRecord" },
      "description": "Backup, restore, and Drive sync history"
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "User financial operation audit logs"
    }
  }
}
